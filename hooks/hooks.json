{
  "description": "Tell an app's session when a newer jimbo.ui release is installed than the one the app is on.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-version.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
